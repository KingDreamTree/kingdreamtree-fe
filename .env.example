# REFIT API v1 base URL. Keep the /api/v1 suffix.
VITE_API_BASE_URL=https://api.refit.live/api/v1

# Enable only after the privacy-preserving pod flow is live. This value is the
# complete pod upload URL and must not be returned by the API or stored.
VITE_PRIVATE_PHOTO_FLOW=false
VITE_GPU_POD_UPLOAD_URL=
